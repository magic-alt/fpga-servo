		(uuid "7fb5c690-dd89-4b27-bef9-9399a6dccd1a")
	)
	(text "TPD6E05U06 provides six low-capacitance shunt ESD channels directly at A+/A-/B+/B-/Z+/Z-. Keep it adjacent to J5; exact UQFN footprint remains a fabrication gate."
		(exclude_from_sim no)
		(at 16.51 169.164 0)
		(effects
			(font
				(size 1.27 1.27)
				(thickness 0.254)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "c7f1407e-d5ed-4e05-a7f1-82b576ddc015")
	)
