	(text "VISIBLE WIRING: differential ABZ pairs, termination, ESD, line receiver and encoder power are explicitly wired; receiver outputs go directly to hierarchy ports."
		(exclude_from_sim no)
		(at 16.51 177.292 0)
		(effects
