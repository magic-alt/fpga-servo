# AX7010 Servo Drive Rev.A
# Official recent AX7010 docs: PL_A=J10, PL_B=J11.
# All user PL I/O here is 3.3 V LVCMOS.

# PL_A / J10
set_property PACKAGE_PIN W19 [get_ports PWM_UH];        set_property IOSTANDARD LVCMOS33 [get_ports PWM_UH]
set_property PACKAGE_PIN W18 [get_ports PWM_UL];        set_property IOSTANDARD LVCMOS33 [get_ports PWM_UL]
set_property PACKAGE_PIN R14 [get_ports PWM_VH];        set_property IOSTANDARD LVCMOS33 [get_ports PWM_VH]
set_property PACKAGE_PIN P14 [get_ports PWM_VL];        set_property IOSTANDARD LVCMOS33 [get_ports PWM_VL]
set_property PACKAGE_PIN Y17 [get_ports PWM_WH];        set_property IOSTANDARD LVCMOS33 [get_ports PWM_WH]
set_property PACKAGE_PIN Y16 [get_ports PWM_WL];        set_property IOSTANDARD LVCMOS33 [get_ports PWM_WL]
set_property PACKAGE_PIN W15 [get_ports GATE_EN];       set_property IOSTANDARD LVCMOS33 [get_ports GATE_EN]
set_property PACKAGE_PIN V15 [get_ports FAULT_CLEAR];   set_property IOSTANDARD LVCMOS33 [get_ports FAULT_CLEAR]
set_property PACKAGE_PIN Y14 [get_ports ADC_CONVST];    set_property IOSTANDARD LVCMOS33 [get_ports ADC_CONVST]
set_property PACKAGE_PIN W14 [get_ports ADC_SCLK];      set_property IOSTANDARD LVCMOS33 [get_ports ADC_SCLK]
set_property PACKAGE_PIN P18 [get_ports ADC_CS_N];      set_property IOSTANDARD LVCMOS33 [get_ports ADC_CS_N]
set_property PACKAGE_PIN N17 [get_ports ADC_RESET];     set_property IOSTANDARD LVCMOS33 [get_ports ADC_RESET]
set_property PACKAGE_PIN U15 [get_ports ADC_DOUTA];     set_property IOSTANDARD LVCMOS33 [get_ports ADC_DOUTA]
set_property PACKAGE_PIN U14 [get_ports ADC_DOUTB];     set_property IOSTANDARD LVCMOS33 [get_ports ADC_DOUTB]
set_property PACKAGE_PIN P16 [get_ports ADC_BUSY];      set_property IOSTANDARD LVCMOS33 [get_ports ADC_BUSY]
set_property PACKAGE_PIN P15 [get_ports ADC_FRSTDATA];  set_property IOSTANDARD LVCMOS33 [get_ports ADC_FRSTDATA]
set_property PACKAGE_PIN U17 [get_ports ENC_A];         set_property IOSTANDARD LVCMOS33 [get_ports ENC_A]
set_property PACKAGE_PIN T16 [get_ports ENC_B];         set_property IOSTANDARD LVCMOS33 [get_ports ENC_B]
set_property PACKAGE_PIN V18 [get_ports ENC_Z];         set_property IOSTANDARD LVCMOS33 [get_ports ENC_Z]
set_property PACKAGE_PIN V17 [get_ports ENC_FAULT_N];   set_property IOSTANDARD LVCMOS33 [get_ports ENC_FAULT_N]
set_property PACKAGE_PIN T15 [get_ports OCP_N];         set_property IOSTANDARD LVCMOS33 [get_ports OCP_N]
set_property PACKAGE_PIN T14 [get_ports PWR_GOOD];      set_property IOSTANDARD LVCMOS33 [get_ports PWR_GOOD]
set_property PACKAGE_PIN V13 [get_ports AUX_IN0];       set_property IOSTANDARD LVCMOS33 [get_ports AUX_IN0]
set_property PACKAGE_PIN U13 [get_ports AUX_IN1];       set_property IOSTANDARD LVCMOS33 [get_ports AUX_IN1]
set_property PACKAGE_PIN W13 [get_ports AUX_OUT0];      set_property IOSTANDARD LVCMOS33 [get_ports AUX_OUT0]
set_property PACKAGE_PIN V12 [get_ports AUX_OUT1];      set_property IOSTANDARD LVCMOS33 [get_ports AUX_OUT1]

# PL_B / J11 - optional ADC parallel + debug
set_property PACKAGE_PIN F17 [get_ports {ADC_DB[0]}];  set_property IOSTANDARD LVCMOS33 [get_ports {ADC_DB[0]}]
set_property PACKAGE_PIN F16 [get_ports {ADC_DB[1]}];  set_property IOSTANDARD LVCMOS33 [get_ports {ADC_DB[1]}]
