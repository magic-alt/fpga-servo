set_property PACKAGE_PIN L17 [get_ports ADC_RANGE];     set_property IOSTANDARD LVCMOS33 [get_ports ADC_RANGE]
set_property PACKAGE_PIN L16 [get_ports ADC_OS0];       set_property IOSTANDARD LVCMOS33 [get_ports ADC_OS0]
set_property PACKAGE_PIN M18 [get_ports ADC_OS1];       set_property IOSTANDARD LVCMOS33 [get_ports ADC_OS1]
set_property PACKAGE_PIN M17 [get_ports ADC_OS2];       set_property IOSTANDARD LVCMOS33 [get_ports ADC_OS2]
set_property PACKAGE_PIN D20 [get_ports ADC_STBY];      set_property IOSTANDARD LVCMOS33 [get_ports ADC_STBY]
